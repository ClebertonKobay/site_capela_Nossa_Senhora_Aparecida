# Postgres (Neon) — pegue em console.neon.tech > seu projeto > Connection string
DATABASE_URL="postgresql://user:password@ep-xxxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Hash Argon2id da senha de admin — gerar com:
# node -e "require('@node-rs/argon2').hash('SUA_SENHA_AQUI').then(console.log)"
ADMIN_PASSWORD_HASH="$argon2id$v=19$..."

# Segredo do JWT (32+ bytes) — gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="..."
