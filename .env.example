# Postgres (Neon) — pegue em console.neon.tech > seu projeto > Connection string
DATABASE_URL="postgresql://user:password@ep-xxxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Criar o primeiro usuário admin (rodar uma vez, localmente, contra o banco real):
# node --env-file=.env.local scripts/create-admin-user.mjs meu.usuario "Meu Nome" "minha senha forte"

# Hash Argon2id da senha de admin, em base64 (o carregador de .env do Next.js
# expande "$nome" como variável — um hash Argon2id cru, cheio de "$", vira
# lixo se colado direto). Gerar com:
# node -e "require('@node-rs/argon2').hash('SUA_SENHA_AQUI').then(h => console.log(Buffer.from(h).toString('base64')))"
# Sendo substituída pela tabela `users` — mantida até o login novo estar funcionando.
ADMIN_PASSWORD_HASH_BASE64="..."

# Segredo do JWT (32+ bytes) — gerar com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="..."
